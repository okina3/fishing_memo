APP_NAME=FishingMemo

# ----------------------------------------------------------------------  
# アプリケーション環境設定
# local: ローカル環境
# APP_ENV=local
# production: 本番環境
APP_ENV=production
# ----------------------------------------------------------------------
APP_KEY=

# ------------------------------------------------------
# デバッグバーの表示、非表示の切り替え
# true: ローカル環境
# APP_DEBUG=true
# false: 本番環境
APP_DEBUG=false

# ------------------------------------------------------
# 開発環境
# APP_URL=http://localhost
# 本番環境
APP_URL=https://fishing-memo-app.link
# 

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DBの設定
# デフォルト
# DB_CONNECTION=sqlite
DB_CONNECTION=mysql
# ----------------------------------------------------------------------  
# 127.0.0.1 : 開発環境
# DB_HOST=127.0.0.1
# database : 本番環境
DB_HOST=database
# ----------------------------------------------------------------------
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# メールの設定
# MAIL_MAILER=log
MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
MAIL_HOST=mail
# MAIL_PORT=2525
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# マルチログイン用のSession Cookie の設定（=の前後に空白を入れない）
SESSION_COOKIE=user
SESSION_COOKIE_ADMIN=admin

# ブラウザバック用のセッション
BROWSER_BACK_KEY=""

# デバッグバーの表示、非表示
DEBUGBAR_ENABLED=false